---
// BuildLayout — temporary reading layout for build posts (the next work
// order replaces it): sticky TOC beside the prose on wide screens, a
// <details> disclosure below that. The TOC highlight and the code bar's
// copy button are added by Enhance.astro's inline script, rendered only
// when this post has a TOC or a code block.
import type { Post } from '../lib/posts';
import type { AstroComponentFactory } from 'astro/runtime/server/index.js';
import type { MarkdownHeading } from 'astro';
import Base from './Base.astro';
import ReadingHead from '../components/ReadingHead.astro';
import PostNav from '../components/PostNav.astro';
import Enhance from '../components/Enhance.astro';
import '../styles/prose-legacy.css';

export interface Props {
  post: Post;
  Content: AstroComponentFactory;
  headings: MarkdownHeading[];
  older: Post | null;
  newer: Post | null;
}

const { post, Content, headings, older, newer } = Astro.props;
const { title, tag, sample, lang } = post.data;
const toc = headings.filter((h) => h.depth === 2);
// A fenced block in the source is what rehypeCodeBar turns into a code bar.
const hasCode = /^\s*(```|~~~)/m.test(post.body ?? '');
---

<Base title={`${title} — wit.et`} rule noindex={sample}>
  <div>
    <div class="wt-build-layout">
      {
        toc.length > 0 && (
          <nav class="wt-toc" aria-label="文章目錄">
            <div class="wt-toc__label">目錄</div>
            {toc.map((h) => (
              <a href={`#${h.slug}`}>{h.text}</a>
            ))}
          </nav>
        )
      }

      <main id="main" class="wt-build-main">
        <article class="wt-prose" lang={lang === 'en' ? 'en' : undefined}>
          <ReadingHead post={post} />
          {
            toc.length > 0 && (
              <details class="wt-toc-mobile">
                <summary>目錄</summary>
                <nav aria-label="文章目錄">
                  {toc.map((h) => (
                    <a href={`#${h.slug}`}>{h.text}</a>
                  ))}
                </nav>
              </details>
            )
          }
          <Content />
          <PostNav tag={tag} older={older} newer={newer} />
        </article>
      </main>
    </div>
  </div>
  {(toc.length > 0 || hasCode) && <Enhance />}
</Base>

<style>
  /* minmax(0, ...) so a long unwrapped code line cannot widen the track. */
  .wt-build-layout {
    display: grid;
    grid-template-columns: minmax(0, 200px) minmax(0, 1fr);
    gap: 56px;
  }
  .wt-build-main {
    min-width: 0;
    max-width: 680px;
  }
  @media (max-width: 820px) {
    .wt-build-layout {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
    }
  }
</style>
