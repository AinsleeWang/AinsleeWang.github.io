---
// PhotoLayout — PHOTO/TRAVEL reading page (design-ref/wit.et Blog.dc.html
// 1g, lines 431-464). Deep-space mode, shared by both tags. Title block is
// capped at 820px; images (the cover ImageSlot placeholder, and any
// standalone markdown image turned into a <figure> by
// src/lib/markdown-plugins.mjs's rehypeFigureImages) run the full content
// width; body paragraphs are capped at 620px like the design-ref's closing
// paragraph (line 460).
//
// The cover is the first image on the page, so it loads eagerly.
import type { Post } from '../lib/posts';
import type { AstroComponentFactory } from 'astro/runtime/server/index.js';
import Base from './Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import PostNav from '../components/PostNav.astro';
import ImageSlot from '../components/ImageSlot.astro';
import '../styles/prose-deep.css';

export interface Props {
  post: Post;
  mode: 'paper' | 'deep-space';
  Content: AstroComponentFactory;
  older: Post | null;
  newer: Post | null;
}

const { post, mode, Content, older, newer } = Astro.props;
const { title, date, tag, summary, frames, location, cover, coverAlt, sample, lang } = post.data;

const formatDate = (d: Date) =>
  `${d.getUTCFullYear()}.${String(d.getUTCMonth() + 1).padStart(2, '0')}.${String(d.getUTCDate()).padStart(2, '0')}`;

const metaParts = [formatDate(date)];
if (location) metaParts.push(location);
if (frames != null) metaParts.push(`${frames} FRAMES`);
---

<Base title={`${title} — wit.et`} description={summary} mode={mode} noindex={sample}>
  <div class="container page">
    <SiteHeader mode={mode} glow={false} />

    <main id="main">
      <article class="wt-deep-article" lang={lang === 'en' ? 'en' : undefined}>
        <div class="wt-photo-head">
          <div class="wt-meta-row">
            <span class="wt-tag">{tag}</span>
            <span class="wt-meta">{metaParts.join(' · ')}</span>
          </div>
          <h1>{title}</h1>
          {summary && <p class="wt-lede">{summary}</p>}
        </div>

        <div class="wt-photo-cover">
          <ImageSlot ratio="16/9" seed={post.id} tag={tag} title={title} cover={cover} alt={coverAlt ?? title} eager />
        </div>

        <div class="wt-photo-body">
          <Content />
        </div>

        <PostNav tag={tag} mode={mode} older={older} newer={newer} />
      </article>
    </main>
  </div>
</Base>

<style>
  .page {
    padding-block: 26px 64px;
  }

  .wt-photo-head {
    max-width: 820px;
    padding-top: var(--reading-top);
  }

  .wt-photo-cover {
    margin-top: 30px;
  }

  .wt-photo-body {
    margin-top: 44px;
  }
</style>

<style is:global>
  /* .wt-photo-body wraps <Content />'s output (not authored directly in
     this file's template), so — same reasoning as BuildLayout's .wt-code
     rules — this needs is:global rather than a scoped selector. */
  .wt-photo-body p {
    max-width: 620px;
  }
</style>
