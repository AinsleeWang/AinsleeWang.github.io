---
// EssayLayout — temporary reading layout (the next work order replaces it).
import type { Post } from '../lib/posts';
import type { AstroComponentFactory } from 'astro/runtime/server/index.js';
import Base from './Base.astro';
import ReadingHead from '../components/ReadingHead.astro';
import PostNav from '../components/PostNav.astro';
import '../styles/prose-legacy.css';

export interface Props {
  post: Post;
  Content: AstroComponentFactory;
  older: Post | null;
  newer: Post | null;
}

const { post, Content, older, newer } = Astro.props;
const { title, tag, summary, sample, lang } = post.data;
---

<Base title={`${title} — wit.et`} description={summary} rule noindex={sample}>
  <main id="main">
    <article class="wt-prose" lang={lang === 'en' ? 'en' : undefined}>
      <ReadingHead post={post} />
      {summary && <p class="wt-lede">{summary}</p>}
      <Content />
    </article>
    <PostNav tag={tag} older={older} newer={newer} />
  </main>
</Base>
