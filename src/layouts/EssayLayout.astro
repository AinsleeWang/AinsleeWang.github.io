---
// EssayLayout — ESSAY reading page (design-ref/wit.et Blog.dc.html 1e,
// lines 336-374). Paper mode, single column, vendored article.css
// (wit-et-design-system feat/e4-article-layout) for the long-form prose;
// src/styles/site-scale.css carries the one allowed C2 override (body
// 18px / measure 620px / caption 12px, see that file's comment).
//
// `.wt-tag`/`.wt-meta-row`/`.wt-meta` come straight from article.css
// rather than the MonoTag component: MonoTag has no border box around the
// tag and isn't mode-aware (always --moss-300), so it can't reproduce 1e's
// bordered tag + paper-mode moss-700 meta text. SiteHeader is reused as
// specified (glow={false}, the 34x17 inner-page variant + the article nav).
import type { Post } from '../lib/posts';
import { readingMinutes } from '../lib/posts';
import type { AstroComponentFactory } from 'astro/runtime/server/index.js';
import Base from './Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import PostNav from '../components/PostNav.astro';
import '../styles/vendor/article.css';

export interface Props {
  post: Post;
  mode: 'paper' | 'deep-space';
  Content: AstroComponentFactory;
  // Adjacent essays by date (null when there is none on that side).
  older: Post | null;
  newer: Post | null;
}

const { post, mode, Content, older, newer } = Astro.props;
const { title, date, tag, summary, sample, location } = post.data;
const minutes = readingMinutes(post);

const formatDate = (d: Date) =>
  `${d.getUTCFullYear()}.${String(d.getUTCMonth() + 1).padStart(2, '0')}.${String(d.getUTCDate()).padStart(2, '0')}`;
const dateStr = formatDate(date);

const ARTICLE_NAV = [
  { label: '索引', href: '/' },
  { label: '關於', href: '/about/' },
  { label: 'RSS', href: '/rss.xml' },
];
---

<Base title={`${title} — wit.et`} description={summary} mode={mode} noindex={sample}>
  <div class="container page">
    <SiteHeader mode={mode} glow={false} nav={ARTICLE_NAV} />

    <article class="wt-article">
      <div class="wt-meta-row">
        <span class="wt-tag">{tag}</span>
        <span class="wt-meta">
          {dateStr}
          {location && ` · ${location}`}
          {` · ${minutes} MIN`}
        </span>
      </div>
      <h1>{title}</h1>
      {summary && <p class="wt-lede">{summary}</p>}
      <hr />
      <Content />
      <PostNav tag={tag} mode={mode} older={older} newer={newer} />
    </article>
  </div>
</Base>

<style>
  .page {
    padding-block: 26px 72px;
  }
</style>
