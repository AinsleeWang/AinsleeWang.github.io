---
import '../styles/vendor/tokens.css';
import '../styles/global.css';
import '../styles/site-scale.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import type { NavKey } from '../components/SiteHeader.astro';
import { tokenValue } from '../lib/tokens';
import { existsSync } from 'node:fs';
import { join } from 'node:path';

const SITE_DESCRIPTION = '才智，以及其他。一張永遠沒寫完的清單——程式、文字，et cetera。';

export interface Props {
  title: string;
  description?: string;
  // Which nav item aria-current marks (home and tag pages: 'index').
  current?: NavKey;
  // Hairline under the header (reading pages; the home masthead has its own).
  rule?: boolean;
  // Seed posts carry `sample: true` — their reading pages render but
  // shouldn't be indexed until real content lands.
  noindex?: boolean;
  // The page lays out its own `.wrap` sections (full-width bands between
  // them); Base then only renders the header and footer, each in a wrap.
  bleed?: boolean;
  // Open Graph: 'article' for reading pages (with publishedTime), else 'website'.
  type?: 'website' | 'article';
  publishedTime?: Date;
  // Name of the share card in public/og/ (a post's slug); falls back to default.
  ogSlug?: string;
  // Structured data, written as one application/ld+json block.
  jsonLd?: Record<string, unknown>;
}

const {
  title,
  description = SITE_DESCRIPTION,
  current,
  rule = false,
  noindex = false,
  bleed = false,
  type = 'website',
  publishedTime,
  ogSlug,
  jsonLd,
} = Astro.props;

const site = Astro.site ?? new URL('http://localhost:4321');
const pathname = Astro.url.pathname;
const isNotFound = pathname.startsWith('/404');
const canonical = new URL(pathname, site).href;
// Share cards are generated before the build (scripts/og.mjs). A page uses its
// own card, else the default; with neither on disk it has no og:image.
const hasCard = (name: string) => existsSync(join(process.cwd(), 'public', 'og', `${name}.png`));
const cardName = ogSlug && hasCard(ogSlug) ? ogSlug : hasCard('default') ? 'default' : null;
const ogImage = cardName ? new URL(`/og/${cardName}.png`, site).href : null;

// Four faces, each with one job (docs/EDITORIAL-SPEC.md section 2).
const fontsHref =
  'https://fonts.googleapis.com/css2?family=Noto+Serif+TC:wght@400;500;700' +
  '&family=EB+Garamond:ital,wght@0,400;0,500;1,400;1,500' +
  '&family=JetBrains+Mono:wght@400;500&family=Space+Grotesk:wght@500&display=swap';
const themeColor = tokenValue('paper');
---

<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content={themeColor} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="alternate" type="application/rss+xml" title="wit.et" href="/rss.xml" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {!isNotFound && <link rel="canonical" href={canonical} />}

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="zh_TW" />
    <meta property="og:site_name" content="wit.et" />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && <meta property="og:image:width" content="1200" />}
    {ogImage && <meta property="og:image:height" content="630" />}
    <meta name="twitter:card" content="summary_large_image" />
    {type === 'article' && publishedTime && (
      <meta property="article:published_time" content={publishedTime.toISOString()} />
    )}
    {jsonLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={fontsHref} />
  </head>
  <body data-mode="paper">
    <a class="skip-link" href="#main">跳到內容</a>
    {
      bleed ? (
        <>
          <div class="wrap">
            <SiteHeader current={current} rule={rule} />
          </div>
          <slot />
          <div class="wrap">
            <SiteFooter />
          </div>
        </>
      ) : (
        <div class="wrap">
          <SiteHeader current={current} rule={rule} />
          <slot />
          <SiteFooter />
        </div>
      )
    }
  </body>
</html>
