---
import '../styles/vendor/tokens.css';
import '../styles/global.css';
import '../styles/site-scale.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import type { NavKey } from '../components/SiteHeader.astro';
import { tokenValue } from '../lib/tokens';

export interface Props {
  title: string;
  description?: string;
  // Which nav item aria-current marks (home and tag pages: 'index').
  current?: NavKey;
  // Hairline under the header (reading pages; the home masthead has its own).
  rule?: boolean;
  // Seed posts carry `sample: true` — their reading pages render but
  // shouldn't be indexed until real content lands.
  noindex?: boolean;
  // The page lays out its own `.wrap` sections (full-width bands between
  // them); Base then only renders the header and footer, each in a wrap.
  bleed?: boolean;
}

const { title, description, current, rule = false, noindex = false, bleed = false } = Astro.props;

// Four faces, each with one job (docs/EDITORIAL-SPEC.md section 2).
const fontsHref =
  'https://fonts.googleapis.com/css2?family=Noto+Serif+TC:wght@400;500;700' +
  '&family=EB+Garamond:ital,wght@0,400;0,500;1,400;1,500' +
  '&family=JetBrains+Mono:wght@400;500&family=Space+Grotesk:wght@500&display=swap';
const themeColor = tokenValue('paper');
---

<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content={themeColor} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="wit.et" href="/rss.xml" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex" />}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={fontsHref} />
  </head>
  <body data-mode="paper">
    <a class="skip-link" href="#main">跳到內容</a>
    {
      bleed ? (
        <>
          <div class="wrap">
            <SiteHeader current={current} rule={rule} />
          </div>
          <slot />
          <div class="wrap">
            <SiteFooter />
          </div>
        </>
      ) : (
        <div class="wrap">
          <SiteHeader current={current} rule={rule} />
          <slot />
          <SiteFooter />
        </div>
      )
    }
  </body>
</html>
