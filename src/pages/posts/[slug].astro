---
// Article reading page: every post, whatever its tag, uses ArticleLayout.
import { render } from 'astro:content';
import { adjacentPosts, getPublishedPosts } from '../../lib/posts';
import type { Post } from '../../lib/posts';
import ArticleLayout from '../../layouts/ArticleLayout.astro';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post, ...adjacentPosts(post, posts) },
  }));
}

export interface Props {
  post: Post;
  older: Post | null;
  newer: Post | null;
}

const { post, older, newer } = Astro.props;
const { Content, headings } = await render(post);
---

<ArticleLayout post={post} Content={Content} headings={headings} older={older} newer={newer} />
