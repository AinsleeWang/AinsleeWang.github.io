---
// Article reading page — E-1.3 (roadmap, first half; tag pages + RSS are
// the next ticket, not built here). Dispatches by `tag` to one of three
// layouts; the *mode* each layout renders in always comes from
// src/lib/modes.ts's modeForTag (never hardcoded here), per
// docs/DECISIONS.md C1.
import { render } from 'astro:content';
import { adjacentPosts, getPublishedPosts } from '../../lib/posts';
import type { Post } from '../../lib/posts';
import { modeForTag } from '../../lib/modes';
import EssayLayout from '../../layouts/EssayLayout.astro';
import BuildLayout from '../../layouts/BuildLayout.astro';
import PhotoLayout from '../../layouts/PhotoLayout.astro';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post, ...adjacentPosts(post, posts) },
  }));
}

export interface Props {
  post: Post;
  older: Post | null;
  newer: Post | null;
}

const { post, older, newer } = Astro.props;
const { Content, headings } = await render(post);
const mode = modeForTag[post.data.tag];
---

{post.data.tag === 'essay' && <EssayLayout post={post} mode={mode} Content={Content} older={older} newer={newer} />}
{post.data.tag === 'build' && <BuildLayout post={post} mode={mode} Content={Content} headings={headings} older={older} newer={newer} />}
{
  (post.data.tag === 'photo' || post.data.tag === 'travel') && (
    <PhotoLayout post={post} mode={mode} Content={Content} older={older} newer={newer} />
  )
}
