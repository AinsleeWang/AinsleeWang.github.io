---
// Article reading page. Dispatches by `tag` to one of three layouts (a
// temporary split; the next work order merges them into one).
import { render } from 'astro:content';
import { adjacentPosts, getPublishedPosts } from '../../lib/posts';
import type { Post } from '../../lib/posts';
import EssayLayout from '../../layouts/EssayLayout.astro';
import BuildLayout from '../../layouts/BuildLayout.astro';
import PhotoLayout from '../../layouts/PhotoLayout.astro';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post, ...adjacentPosts(post, posts) },
  }));
}

export interface Props {
  post: Post;
  older: Post | null;
  newer: Post | null;
}

const { post, older, newer } = Astro.props;
const { Content, headings } = await render(post);
---

{post.data.tag === 'essay' && <EssayLayout post={post} Content={Content} older={older} newer={newer} />}
{post.data.tag === 'build' && <BuildLayout post={post} Content={Content} headings={headings} older={older} newer={newer} />}
{
  (post.data.tag === 'photo' || post.data.tag === 'travel') && (
    <PhotoLayout post={post} Content={Content} older={older} newer={newer} />
  )
}
