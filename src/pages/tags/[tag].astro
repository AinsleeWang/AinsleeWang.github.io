---
// Tag index page — E-1.3 part 2. One static page per tag (essay/build/
// photo/travel), all deep-space mode (docs/DECISIONS.md: "索引頁走深空").
// Reuses the homepage's SiteHeader (default nav: 關於/Projects/RSS) and
// FilterBar, with `active` set to this page's own tag. essay/photo/travel
// reuse PostCard with the exact same shape logic as the homepage stream
// (src/pages/index.astro); build uses its own list-row style, lifted from
// design-ref/wit.et Blog.dc.html lines 126-129 (artboard 1b's BUILD rows —
// only the row style, not 1b's rejected single-column layout).
import { getPublishedPosts, readingMinutes } from '../../lib/posts';
import Base from '../../layouts/Base.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import FilterBar from '../../components/FilterBar.astro';
import PostCard from '../../components/PostCard.astro';
import EmptyState from '../../components/EmptyState.astro';

export async function getStaticPaths() {
  return (['essay', 'build', 'photo', 'travel'] as const).map((tag) => ({ params: { tag } }));
}

const { tag } = Astro.params as { tag: 'essay' | 'build' | 'photo' | 'travel' };

const allPosts = await getPublishedPosts();
const posts = allPosts.filter((p) => p.data.tag === tag);

// Same condition as src/pages/index.astro's featuredId: the newest post in
// the list gets the feature card treatment only when it's tagged photo.
// On this page every post already shares `tag`, so this only ever fires on
// /tags/photo/ (where it's always true) — kept as the identical expression
// rather than a tag-specific shortcut, so the two pages' card logic can
// never drift apart.
const featuredId = posts[0]?.data.tag === 'photo' ? posts[0].id : null;

const formatShortDate = (d: Date) => `${String(d.getUTCMonth() + 1).padStart(2, '0')}.${String(d.getUTCDate()).padStart(2, '0')}`;

const titleTag = tag.toUpperCase();
---

<Base title={`${titleTag} — wit.et`} mode="deep-space">
  <div class="container page">
    <SiteHeader mode="deep-space" />
    <FilterBar active={tag} count={posts.length} />

    <main class="layout">
      {
        posts.length === 0 ? (
          <EmptyState />
        ) : tag === 'build' ? (
          <div class="build-list">
            {posts.map((post) => (
              <a href={`/posts/${post.id}/`} class="build-list__row">
                <span class="build-list__label">BUILD</span>
                <span class="build-list__title">{post.data.title}</span>
                <span class="build-list__meta">
                  {formatShortDate(post.data.date)}
                  {` · ${readingMinutes(post)} MIN`}
                </span>
              </a>
            ))}
          </div>
        ) : (
          <section class="stream" aria-label={`${titleTag} 文章列表`}>
            {posts.map((post, i) => (
              <PostCard post={post} featured={post.id === featuredId} eager={i === 0} />
            ))}
          </section>
        )
      }
    </main>
  </div>
</Base>

<style>
  .page {
    padding-block: 32px 64px;
  }
  .layout {
    padding-top: 8px;
  }
  .stream {
    display: block;
    min-width: 0;
  }

  .build-list {
    border-bottom: 1px solid var(--line-16);
    padding: 6px 0;
  }
  .build-list__row {
    display: flex;
    align-items: baseline;
    gap: 20px;
    padding: 11px 0;
    color: var(--fg);
  }
  .build-list__row:not(:first-child) {
    border-top: 1px solid color-mix(in srgb, var(--moss-300) 8%, transparent);
  }
  .build-list__row:hover,
  .build-list__row:focus-visible {
    color: var(--functional);
  }
  .build-list__label {
    width: 56px;
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: var(--fs-meta);
    letter-spacing: 0.06em;
    color: var(--moss-300);
  }
  .build-list__title {
    flex: 1;
    font-family: var(--font-stack);
    font-size: var(--fs-tag-row-title);
  }
  .build-list__meta {
    font-family: var(--font-mono);
    font-size: var(--fs-meta);
    color: var(--muted-62);
    white-space: nowrap;
  }

  @media (max-width: 767px) {
    .page {
      padding-block: 18px 40px;
    }
    /* 44px touch target, per 1h (e.g. lines 490/507). */
    .build-list__row {
      min-height: 44px;
      box-sizing: border-box;
    }
  }
</style>
