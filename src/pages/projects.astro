---
// Projects (docs/EDITORIAL-SPEC.md section 6): the numbered list again, one
// row per project, numbered like the home list (the newest in the list gets
// the highest number). Copy and data: design-ref/editorial/pages-copy.md.
import { PROJECTS } from '../data/projects';
import Base from '../layouts/Base.astro';
import ListHead from '../components/ListHead.astro';
import Lat from '../components/Lat.astro';
import '../styles/list.css';

const rows = PROJECTS.map((p, i) => ({
  ...p,
  no: String(PROJECTS.length - i).padStart(2, '0'),
}));
---

<Base
  title="作品 — wit.et"
  description="wit.et 公開的專案：網站、地圖工具、Android app 與資料流程的紀錄。"
  current="projects"
>
  <main id="main">
    <ListHead title="作品">做過、而且公開放著的東西。</ListHead>
    <section class="toc" aria-label="作品列表">
      {
        rows.map((p) => (
          <article class="row">
            <div class="no">
              <Lat>{p.no}</Lat>
            </div>
            <div>
              <h2 class="name">{p.name}</h2>
              <p class="title">{p.description}</p>
              <p class="stack">{p.stack.join(' · ')}</p>
            </div>
            <div class="meta">
              <Lat>{p.year}</Lat>
              <p class="links">
                {p.links.live && (
                  <a href={p.links.live} rel="noopener">
                    live
                  </a>
                )}
                <a href={p.links.source} rel="noopener">
                  source
                </a>
              </p>
            </div>
          </article>
        ))
      }
      <p class="end">清單還在寫 ⋯</p>
    </section>
  </main>
</Base>

<style>
  /* Names are pure Latin: Garamond roman 500, never the 700 used for Chinese. */
  .name {
    font-family: var(--en);
    font-weight: 500;
    font-size: var(--fs-row-line);
    line-height: 1.25;
    letter-spacing: 0;
    overflow-wrap: anywhere;
  }
  .title {
    max-width: 34em;
  }
  .stack {
    margin-top: 12px;
    font-family: var(--en);
    font-size: var(--fs-stack);
    line-height: 1.6;
    color: var(--ink-60);
  }
  .links {
    display: flex;
    justify-content: flex-end;
    gap: 22px;
    margin-top: 8px;
    font-family: var(--en);
    font-style: italic;
    font-size: var(--fs-ft-nav);
    color: var(--ink-70);
  }
  .links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 5px;
  }
  .links a:hover {
    color: var(--moss-700);
  }
  @media (max-width: 820px) {
    .name {
      font-size: var(--fs-row-line-m);
    }
    .links {
      justify-content: flex-start;
    }
  }
</style>
