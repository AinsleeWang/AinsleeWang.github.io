---
// Home (docs/EDITORIAL-SPEC.md section 4, design-ref/editorial/home.html):
// masthead, filter bar, feature (newest post), numbered list, end line.
import { excerpt, formatDate, getPublishedPosts, postNumbers, readingMinutes } from '../lib/posts';
import { TAG_LABEL } from '../lib/labels';
import Base from '../layouts/Base.astro';
import Masthead from '../components/Masthead.astro';
import FilterBar from '../components/FilterBar.astro';
import PostList from '../components/PostList.astro';
import ImageSlot from '../components/ImageSlot.astro';
import Lat from '../components/Lat.astro';
import Mixed from '../components/Mixed.astro';
import Phrases from '../components/Phrases.astro';

const all = await getPublishedPosts();
const numbers = postNumbers(all);
const [feat, ...rest] = all;
---

<Base title="wit.et — 才智，以及其他。" description="程式、文字、照片、路上——一份永遠沒寫完的清單。" current="index">
  <main id="main">
    <Masthead />
    <FilterBar active="all" count={all.length} />

    {
      feat && (
        <article class="feat">
          <div>
            <div class="kick">{TAG_LABEL[feat.data.tag]}</div>
            {feat.data.cover && (
              <div class="cover">
                <ImageSlot ratio="3/2" cover={feat.data.cover} alt={feat.data.coverAlt ?? feat.data.title} eager />
              </div>
            )}
            <a class="line-link" href={`/posts/${feat.id}/`}>
              <p class="line">
                <Phrases text={feat.data.summary ?? feat.data.title} />
              </p>
            </a>
          </div>
          <div class="side">
            {feat.data.summary && <h2 class="title">{feat.data.title}</h2>}
            <p class="meta">
              <Lat>{formatDate(feat.data.date)}</Lat>
              {feat.data.location && (
                <>
                  {'　'}
                  <Mixed text={feat.data.location} />
                </>
              )}
              {'　'}約 <Lat>{readingMinutes(feat)}</Lat> 分鐘
            </p>
            <p class="excerpt">{excerpt(feat)}</p>
          </div>
        </article>
      )
    }

    <PostList posts={rest} numbers={numbers} archive={all.length > 10} />
  </main>
</Base>

<style>
  .feat {
    position: relative;
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: 72px;
    padding: 72px 0 76px;
    border-bottom: 1px solid var(--rule-strong);
  }
  .cover {
    margin-top: 30px;
  }
  .line {
    margin-top: 30px;
    font-family: var(--zh);
    font-weight: 700;
    font-size: var(--fs-feat);
    line-height: 1.28;
    letter-spacing: 0.02em;
    text-wrap: balance;
  }
  /* The whole feature is the link: the large line's anchor is stretched
     over the block. */
  .line-link::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .feat:hover .line {
    color: var(--moss-700);
  }
  .side {
    align-self: end;
    padding-bottom: 8px;
  }
  .title {
    font-family: var(--zh);
    font-weight: 700;
    font-size: var(--fs-title);
    line-height: 1.6;
    letter-spacing: 0.04em;
  }
  .excerpt {
    margin-top: 22px;
    font-family: var(--zh);
    font-size: var(--fs-excerpt);
    line-height: 2;
    letter-spacing: 0.05em;
    text-align: justify;
    color: var(--ink-70);
  }

  @media (max-width: 820px) {
    .feat {
      grid-template-columns: 1fr;
      gap: 28px;
      padding: 44px 0 48px;
    }
  }
</style>
