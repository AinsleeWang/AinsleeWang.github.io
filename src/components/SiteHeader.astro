---
// SiteHeader — logo + nav, per design-ref/wit.et Blog.dc.html 1a (lines
// 45-53, homepage: 40x20 logo with the starglow node's glow ring) and the
// smaller 34x17 variant used on inner pages (1c line 172, 1e lines 342-345,
// no glow ring). E-1.3's article pages reuse this with glow={false}.
//
// Color rule (brief): deep-space uses --moss-300 for logo+nav, paper uses
// --moss-600 for the logo and --moss-700 for nav (design-ref 1e, lines
// 342-345). --starglow is the one exception allowed on the last node.
//
// One nav everywhere (docs/POLISH-SPEC.md section 3). `current` marks the
// page the visitor is on with aria-current="page"; only a nav item's own
// page sets it (the homepage for 索引 — tag and reading pages set nothing).
// `rule` draws the bottom hairline; the homepage turns it off because the
// hero supplies its own top rule.
export type NavKey = 'index' | 'about' | 'projects';

export interface Props {
  mode: 'paper' | 'deep-space';
  glow?: boolean;
  current?: NavKey;
  rule?: boolean;
}

const NAV: { key: NavKey | 'rss'; label: string; href: string }[] = [
  { key: 'index', label: '索引', href: '/' },
  { key: 'about', label: '關於', href: '/about/' },
  { key: 'projects', label: 'PROJECTS', href: '/projects/' },
  { key: 'rss', label: 'RSS', href: '/rss.xml' },
];

const { mode, glow = true, current, rule = true } = Astro.props;
const lineColor = mode === 'paper' ? 'var(--moss-600)' : 'var(--moss-300)';
const navColor = mode === 'paper' ? 'var(--moss-700)' : 'var(--moss-300)';
---

<header class={`site-header site-header--${mode}${rule ? ' site-header--rule' : ''}`} style={`--line-color:${lineColor}; --nav-color:${navColor};`}>
  <a href="/" class="site-header__brand" aria-label="wit.et — 首頁">
    {
      glow ? (
        <svg width="40" height="20" viewBox="0 0 100 48" fill="none" aria-hidden="true">
          <polyline points="6,8 28,40 50,12 72,40 94,6" stroke={lineColor} stroke-width="2" fill="none"></polyline>
          <circle cx="6" cy="8" r="4.5" fill={lineColor}></circle>
          <circle cx="28" cy="40" r="3" fill={lineColor}></circle>
          <circle cx="50" cy="12" r="3.5" fill={lineColor}></circle>
          <circle cx="72" cy="40" r="3" fill={lineColor}></circle>
          <circle cx="94" cy="6" r="4" fill="var(--starglow)"></circle>
          <circle cx="94" cy="6" r="9" stroke="var(--starglow)" stroke-width="1.5" fill="none"></circle>
        </svg>
      ) : (
        <svg width="34" height="17" viewBox="0 0 100 48" fill="none" aria-hidden="true">
          <polyline points="6,8 28,40 50,12 72,40 94,6" stroke={lineColor} stroke-width="2" fill="none"></polyline>
          <circle cx="6" cy="8" r="4.5" fill={lineColor}></circle>
          <circle cx="28" cy="40" r="3" fill={lineColor}></circle>
          <circle cx="50" cy="12" r="3.5" fill={lineColor}></circle>
          <circle cx="72" cy="40" r="3" fill={lineColor}></circle>
          <circle cx="94" cy="6" r="4" fill="var(--starglow)"></circle>
        </svg>
      )
    }
    <span class="site-header__wordmark">wit.et</span>
  </a>
  <nav class="site-header__nav" aria-label="主導覽">
    {
      NAV.map((item) => (
        <a href={item.href} aria-current={item.key === current ? 'page' : undefined}>
          {item.label}
        </a>
      ))
    }
  </nav>
</header>

<style>
  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 28px;
  }
  .site-header--rule {
    border-bottom: 1px solid var(--line-22);
  }
  .site-header--paper {
    padding-bottom: 20px;
  }
  .site-header--paper.site-header--rule {
    border-bottom-color: var(--line-paper-12);
  }
  .site-header__brand {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  /* The mark keeps one view-transition name on every page, so it is held
     in place across a navigation while the rest of the page cross-fades. */
  .site-header__brand svg {
    view-transition-name: site-logo;
  }
  .site-header__brand:hover,
  .site-header__brand:focus-visible {
    color: inherit;
  }
  .site-header__wordmark {
    font-family: var(--font-en);
    font-size: var(--fs-logo);
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--fg);
  }
  .site-header__nav {
    display: flex;
    gap: 28px;
    /* Mono for the Latin items; the two CJK items fall through to the
       mode's own CJK face instead of a system fallback. */
    font-family: var(--font-mono-stack);
    font-size: var(--fs-nav);
    /* Fixed line-height + baseline alignment: the CJK face has taller
       metrics than the mono one and would otherwise sit lower. */
    line-height: 1.5;
    align-items: baseline;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  .site-header__nav a {
    color: var(--nav-color);
  }
  .site-header__nav a[aria-current='page'] {
    padding-bottom: 3px;
    border-bottom: 1px solid var(--nav-color);
  }

  @media (max-width: 767px) {
    /* 44px touch target, per 1h (e.g. lines 490/507). Scoped to the mobile
       media query only — min-height is a floor, and .site-header already
       centers its children vertically, so this doesn't shift the logo's
       position or change its rendered height at 1280px. */
    .site-header {
      gap: 12px;
    }
    .site-header__brand {
      min-height: 44px;
    }
    .site-header__nav {
      gap: 18px;
    }
    .site-header__nav a {
      display: flex;
      align-items: center;
      min-height: 44px;
    }
    /* The 44px box would drop the underline far below the label; draw it
       under the text instead. */
    .site-header__nav a[aria-current='page'] {
      padding-bottom: 0;
      border-bottom: 0;
      text-decoration: underline;
      text-decoration-thickness: 1px;
      text-underline-offset: 6px;
    }
  }
</style>
