---
// SiteHeader — logo + nav (design-ref/editorial). `current` marks the page
// with aria-current="page"; the home page and the tag pages are both 文章.
export type NavKey = 'index' | 'about';
export interface Props {
  current?: NavKey;
  rule?: boolean;
}

const NAV: { key: NavKey; label: string; href: string }[] = [
  { key: 'index', label: '文章', href: '/' },
  { key: 'about', label: '關於', href: '/about/' },
];
const { current, rule = false } = Astro.props;
---

<header class={`hd${rule ? ' hd--rule' : ''}`}>
  <a href="/" class="brand" aria-label="wit.et — 首頁">
    <svg width="36" height="18" viewBox="0 0 100 48" fill="none" aria-hidden="true">
      <polyline points="6,8 28,40 50,12 72,40 94,6" stroke="var(--moss-600)" stroke-width="2" fill="none"></polyline>
      <circle cx="6" cy="8" r="4.5" fill="var(--moss-600)"></circle>
      <circle cx="28" cy="40" r="3" fill="var(--moss-600)"></circle>
      <circle cx="50" cy="12" r="3.5" fill="var(--moss-600)"></circle>
      <circle cx="72" cy="40" r="3" fill="var(--moss-600)"></circle>
      <circle cx="94" cy="6" r="4" fill="var(--starglow)"></circle>
    </svg>
    <span>wit.et</span>
  </a>
  <nav class="nav" aria-label="主導覽">
    {
      NAV.map((item) => (
        <a
          href={item.href}
          aria-current={item.key === current ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))
    }
  </nav>
</header>

<style>
  .hd {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: 28px;
  }
  .hd--rule {
    border-bottom: 1px solid var(--rule);
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 500;
    font-size: var(--fs-brand);
  }
  /* The mark keeps one view-transition name on every page. */
  .brand svg {
    view-transition-name: site-logo;
  }
  .nav {
    display: flex;
    gap: 34px;
    font-family: var(--zh);
    font-weight: 700;
    font-size: var(--fs-nav);
    letter-spacing: 0.14em;
  }
  .nav a[aria-current] {
    border-bottom: 1px solid var(--ink);
    padding-bottom: 3px;
  }

  @media (max-width: 820px) {
    .hd {
      gap: 12px;
    }
    .brand {
      min-height: 44px;
    }
    .nav {
      gap: 18px;
      font-size: var(--fs-nav-m);
      letter-spacing: 0.08em;
    }
    .nav a {
      display: flex;
      align-items: center;
      min-height: 44px;
    }
    .nav a[aria-current] {
      border-bottom: 0;
      padding-bottom: 0;
      text-decoration: underline;
      text-decoration-thickness: 1px;
      text-underline-offset: 6px;
    }
  }
</style>
