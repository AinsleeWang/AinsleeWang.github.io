---
// RailCard — the shell shared by the homepage right-rail cards (BUILD LOG,
// THE LIST SO FAR): space-800 ground, hairline border, a mono header row,
// sticky on desktop. Rows are supplied by the caller through the default
// slot. design-ref/wit.et Blog.dc.html 1c lines 232-240.
export interface Props {
  label: string;
  ariaLabel: string;
  count?: string | number;
}

const { label, ariaLabel, count } = Astro.props;
---

<aside class="rail-card" aria-label={ariaLabel}>
  <div class="rail-card__header">
    <span>{label}</span>
    {count != null && <span class="rail-card__count">{count}</span>}
  </div>
  <slot />
</aside>

<style>
  .rail-card {
    background: var(--space-800);
    border: 1px solid var(--line-16);
    border-radius: var(--radius-md);
    padding: 22px 24px;
  }
  .rail-card__header {
    display: flex;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: var(--fs-meta);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-variant-numeric: tabular-nums;
    color: var(--moss-300);
    padding-bottom: 14px;
    border-bottom: 1px solid var(--line-16);
  }
  .rail-card__count {
    color: var(--muted-62);
  }

  @media (min-width: 768px) {
    .rail-card {
      position: sticky;
      top: 24px;
      align-self: start;
      margin-top: 34px;
    }
  }
</style>
