---
// SiteFooter — design-ref/editorial. Rendered by Base.astro on every page.
---

<footer class="ft">
  <span class="sig">wit, et cetera.</span>
  <nav aria-label="頁尾連結">
    <a href="/rss.xml">rss</a>
    <a href="https://www.instagram.com/wit.etcetera/" rel="me noopener">instagram</a>
    <a href="https://github.com/AinsleeWang" rel="me noopener">github</a>
    <span>© 2026</span>
  </nav>
</footer>

<style>
  .ft {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 24px;
    flex-wrap: wrap;
    margin-top: 56px;
    padding: 30px 0 56px;
    border-top: 1px solid var(--rule-strong);
  }
  .sig {
    font-family: var(--en);
    font-style: italic;
    font-size: var(--fs-sig);
  }
  nav {
    display: flex;
    gap: 28px;
    align-items: baseline;
    font-family: var(--en);
    font-style: italic;
    font-size: var(--fs-ft-nav);
    color: var(--ink-70);
  }

  @media (max-width: 820px) {
    nav {
      flex-wrap: wrap;
      gap: 0 22px;
    }
    nav a {
      display: flex;
      align-items: center;
      min-height: 44px;
    }
  }
</style>
