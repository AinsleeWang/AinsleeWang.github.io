---
// SiteFooter — on every page, both modes (docs/POLISH-SPEC.md section 3).
// Left: the ellipsis mark + "wit, et cetera."; right: mono links and the
// copyright; below: the colophon line. Rendered by Base.astro.
import EllipsisMark from './EllipsisMark.astro';

export interface Props {
  mode: 'paper' | 'deep-space';
}

const { mode } = Astro.props;
---

<footer class={`site-footer site-footer--${mode} container`}>
  <div class="site-footer__row">
    <div class="site-footer__brand">
      <EllipsisMark />
      <span>wit, et cetera.</span>
    </div>
    <div class="site-footer__links">
      <a href="/rss.xml">RSS</a>
      <a href="https://www.instagram.com/wit.etcetera/" rel="me noopener">INSTAGRAM</a>
      <a href="https://github.com/AinsleeWang" rel="me noopener">GITHUB</a>
      <span class="site-footer__copy">© 2026 wit.et</span>
    </div>
  </div>
  <p class="site-footer__colophon">SET IN SPACE GROTESK, NOTO SERIF/SANS TC & JETBRAINS MONO · BUILT WITH ASTRO</p>
</footer>

<style>
  .site-footer {
    padding-bottom: 44px;
  }
  .site-footer--deep-space {
    --footer-rule: var(--line-22);
    --footer-accent: var(--moss-300);
    --footer-muted: var(--muted-62);
  }
  .site-footer--paper {
    --footer-rule: var(--line-paper-12);
    --footer-accent: var(--moss-700);
    --footer-muted: var(--muted-paper-62);
  }
  .site-footer__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding-top: 26px;
    border-top: 1px solid var(--footer-rule);
  }
  .site-footer__brand {
    display: flex;
    align-items: center;
    gap: 14px;
    font-family: var(--font-en);
    font-size: var(--fs-footer-brand);
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--footer-accent);
  }
  .site-footer__brand span {
    color: var(--fg);
  }
  .site-footer__links {
    display: flex;
    align-items: center;
    gap: 28px;
    font-family: var(--font-mono);
    font-size: var(--fs-nav);
    letter-spacing: 0.05em;
    font-variant-numeric: tabular-nums;
  }
  .site-footer__links a {
    color: var(--footer-accent);
  }
  .site-footer__copy {
    color: var(--footer-muted);
  }
  .site-footer__colophon {
    margin: 16px 0 0;
    font-family: var(--font-mono);
    font-size: var(--fs-meta);
    line-height: 1.7;
    letter-spacing: 0.06em;
    color: var(--footer-muted);
  }

  @media (max-width: 767px) {
    .site-footer {
      padding-bottom: 32px;
    }
    .site-footer__row {
      flex-direction: column;
      align-items: flex-start;
      gap: 6px;
      padding-top: 22px;
    }
    .site-footer__links {
      flex-wrap: wrap;
      gap: 0 22px;
    }
    /* 44px touch targets. */
    .site-footer__links a,
    .site-footer__copy {
      display: flex;
      align-items: center;
      min-height: 44px;
    }
    .site-footer__colophon {
      margin-top: 4px;
    }
  }
</style>
