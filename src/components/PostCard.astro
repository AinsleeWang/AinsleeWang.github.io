---
// PostCard — one entry in the left-column stream. Shape depends on tag and
// position, per design-ref/wit.et Blog.dc.html 1c lines 185-229:
//   - feature: the newest post, only when it's `photo` — 2.4:1 image with
//     tag/date/title overlaid on top (lines 186-189). No frames/summary row.
//   - essay: text only — mono tag+date, 34px title, summary, "N MIN"
//     (lines 192-197).
//   - media: everything else (photo/travel not in the feature slot) — a
//     fixed 300px-wide 4:3 image beside text (lines 199-206, 215-222).
//     photo shows "N FRAMES"; travel shows the summary instead.
// The whole card links to /posts/<slug>/ (E-1.3 builds that page later;
// a 404 today is expected, per this milestone's brief).
import type { Post } from '../lib/posts';
import { readingMinutes } from '../lib/posts';
import ImageSlot from './ImageSlot.astro';
import MonoTag from './MonoTag.astro';

export interface Props {
  post: Post;
  featured?: boolean;
  eager?: boolean; // first card on the page: its cover loads eagerly
}

const { post, featured = false, eager = false } = Astro.props;
const { tag, title, summary, frames, cover, coverAlt } = post.data;
const minutes = readingMinutes(post);
const coverAltText = coverAlt ?? title;

const formatDate = (d: Date) =>
  `${d.getUTCFullYear()}.${String(d.getUTCMonth() + 1).padStart(2, '0')}.${String(d.getUTCDate()).padStart(2, '0')}`;
const dateStr = formatDate(post.data.date);
const href = `/posts/${post.id}/`;

const variant = tag === 'essay' ? 'essay' : featured ? 'feature' : 'media';
---

<article class={`post-card post-card--${variant}`}>
  <a href={href} class="post-card__link">
    {
      variant === 'feature' && (
        <ImageSlot ratio="2.4/1" labelPosition="top-right" cover={cover} alt={coverAltText} eager={eager}>
          <div>
            <MonoTag tag={tag} date={dateStr} />
            <h2 class="post-card__title post-card__title--feature">{title}</h2>
          </div>
        </ImageSlot>
      )
    }

    {
      variant === 'essay' && (
        <div class="post-card__body">
          <MonoTag tag={tag} date={dateStr} />
          <h2 class="post-card__title post-card__title--lg">{title}</h2>
          {summary && <p class="post-card__summary">{summary}</p>}
          <div class="post-card__meta">{minutes} MIN</div>
        </div>
      )
    }

    {
      variant === 'media' && (
        <div class="post-card__media">
          <ImageSlot
            ratio="4/3"
            cover={cover}
            alt={coverAltText}
            eager={eager}
            widths={[300, 600, 900]}
            sizes="(max-width: 767px) calc(100vw - 40px), 300px"
          />
          <div class="post-card__body post-card__body--media">
            <MonoTag tag={tag} date={dateStr} />
            <h2 class="post-card__title">{title}</h2>
            {tag === 'photo' && frames != null ? (
              <div class="post-card__meta">{frames} FRAMES</div>
            ) : (
              summary && <p class="post-card__summary">{summary}</p>
            )}
          </div>
        </div>
      )
    }
  </a>
</article>

<style>
  .post-card {
    border-bottom: 1px solid var(--line-16);
  }
  .post-card__link {
    display: block;
    color: var(--fg);
    padding: 32px 0;
  }
  .post-card__link:hover,
  .post-card__link:focus-visible {
    color: var(--fg);
  }
  .post-card__link:hover .post-card__title,
  .post-card__link:focus-visible .post-card__title {
    color: var(--functional);
  }

  .post-card--feature .post-card__link {
    padding: 34px 0 30px;
  }
  .post-card__title--feature {
    margin: 8px 0 0;
    font-family: var(--font-stack);
    font-size: var(--fs-feature-title);
    line-height: 1.3;
    font-weight: 500;
  }

  .post-card__title--lg {
    font-size: var(--fs-card-title-lg);
    line-height: 1.3;
  }
  .post-card__title {
    margin: 12px 0 0;
    font-family: var(--font-stack);
    font-size: var(--fs-card-title);
    line-height: 1.35;
    font-weight: 500;
  }
  .post-card__summary {
    margin: 14px 0 0;
    font-family: var(--font-stack);
    font-size: var(--fs-summary);
    line-height: 1.9;
    color: var(--muted-66);
    max-width: 630px;
  }
  .post-card__meta {
    margin-top: 14px;
    font-family: var(--font-mono);
    font-size: var(--fs-meta);
    letter-spacing: 0.06em;
    color: var(--muted-62);
  }

  .post-card__media {
    display: grid;
    /* 300px matches design-ref 1c exactly at 1280px wide; minmax lets the
       image column shrink instead of forcing horizontal overflow at
       narrower desktop widths (down to the 768px breakpoint floor). */
    grid-template-columns: minmax(160px, 300px) minmax(0, 1fr);
    gap: 24px;
    align-items: end;
  }
  .post-card__body--media .post-card__title {
    margin-top: 10px;
    line-height: 1.35;
  }
  .post-card__body--media .post-card__summary {
    margin-top: 10px;
  }
  .post-card__body--media .post-card__meta {
    margin-top: 10px;
  }

  @media (max-width: 767px) {
    .post-card__link {
      padding: 22px 0 20px;
    }
    .post-card__media {
      grid-template-columns: 1fr;
      gap: 10px;
    }
  }
</style>
