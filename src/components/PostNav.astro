---
// PostNav — prev/next within the tag (design-ref/editorial/essay.html .pn).
// 上一篇 = the older neighbour on the left, 下一篇 = the newer on the right.
// With neither side, a single link back to the tag page.
import type { Post } from '../lib/posts';
import { TAG_LABEL } from '../lib/labels';
import type { Tag } from '../lib/labels';

export interface Props {
  tag: Tag;
  older: Post | null;
  newer: Post | null;
}

const { tag, older, newer } = Astro.props;
---

<nav class="pn" aria-label="相鄰文章">
  {
    older || newer ? (
      <>
        {older ? (
          <a href={`/posts/${older.id}/`} rel="prev">
            <span>上一篇</span>
            <b>{older.data.title}</b>
          </a>
        ) : (
          <span class="gap" />
        )}
        {newer && (
          <a class="next" href={`/posts/${newer.id}/`} rel="next">
            <span>下一篇</span>
            <b>{newer.data.title}</b>
          </a>
        )}
      </>
    ) : (
      <a href={`/tags/${tag}/`}>
        <span>更多</span>
        <b>{TAG_LABEL[tag]}</b>
      </a>
    )
  }
</nav>

<style>
  .pn {
    max-width: 680px;
    margin: 64px auto 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
    padding-top: 26px;
    border-top: 1px solid var(--rule-strong);
  }
  a {
    display: block;
    min-height: 44px;
  }
  .pn span {
    display: block;
    font-family: var(--zh);
    font-size: var(--fs-pn-label);
    letter-spacing: 0.3em;
    color: var(--ink-50);
  }
  .pn b {
    display: block;
    margin-top: 6px;
    font-family: var(--zh);
    font-weight: 700;
    font-size: var(--fs-pn-title);
    line-height: 1.6;
    letter-spacing: 0.04em;
  }
  .next {
    grid-column: 2;
    text-align: right;
  }
  a:hover b {
    color: var(--moss-700);
  }

  @media (max-width: 820px) {
    .pn {
      grid-template-columns: 1fr;
      gap: 20px;
    }
    .next {
      grid-column: 1;
      text-align: left;
    }
  }
</style>
