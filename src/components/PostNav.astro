---
// PostNav — reading-page footer: older neighbour on the left, newer on the
// right, both within the same tag. A missing side is omitted; with neither
// side, the "更多 <tag>" link stays. Colours follow the footer each mode
// already used (paper: moss-700 on the article hairline; deep-space:
// moss-300 on line-20).
import type { Post } from '../lib/posts';

export interface Props {
  tag: string;
  mode: 'paper' | 'deep-space';
  older: Post | null;
  newer: Post | null;
}

const { tag, mode, older, newer } = Astro.props;
---

<nav class={`post-nav post-nav--${mode}${older && newer ? ' post-nav--both' : ''}`} aria-label="相鄰文章">
  {
    older || newer ? (
      <>
        {older && (
          <a class="post-nav__link post-nav__link--older" href={`/posts/${older.id}/`} rel="prev">
            <span class="post-nav__text">← {older.data.title}</span>
          </a>
        )}
        {newer && (
          <a class="post-nav__link post-nav__link--newer" href={`/posts/${newer.id}/`} rel="next">
            <span class="post-nav__text">{newer.data.title} →</span>
          </a>
        )}
      </>
    ) : (
      <a class="post-nav__link post-nav__link--older" href={`/tags/${tag}/`}>
        <span class="post-nav__text">← 更多 {tag}</span>
      </a>
    )
  }
</nav>

<style>
  .post-nav {
    display: flex;
    justify-content: space-between;
    align-items: stretch;
    gap: 24px;
    margin-top: 3.25em;
    padding-top: 1.5em;
    border-top: var(--line-hairline) solid var(--post-nav-rule);
    font-family: var(--font-mono);
    font-size: var(--fs-postnav);
    line-height: 1.5;
    letter-spacing: 0.04em;
  }
  .post-nav--paper {
    --post-nav-rule: var(--article-hairline-color);
    --post-nav-color: var(--moss-700);
  }
  .post-nav--deep-space {
    --post-nav-rule: var(--line-20);
    --post-nav-color: var(--moss-300);
  }
  .post-nav__link {
    display: flex;
    align-items: center;
    min-height: 44px;
    min-width: 0;
    max-width: 100%;
  }
  .post-nav--both .post-nav__link {
    max-width: calc(50% - 12px);
  }
  .post-nav__link--newer {
    margin-left: auto;
    justify-content: flex-end;
    text-align: right;
  }
  /* Doubled class: must outrank the prose stylesheets' `.wt-article a` /
     `.wt-deep-article a` underline + link colour. */
  .post-nav.post-nav a.post-nav__link {
    color: var(--post-nav-color);
    text-decoration: none;
  }
  .post-nav.post-nav a.post-nav__link:hover,
  .post-nav.post-nav a.post-nav__link:focus-visible {
    color: var(--functional);
    text-decoration: underline;
  }
  .post-nav__text {
    display: block;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  @media (max-width: 767px) {
    .post-nav {
      flex-direction: column;
      gap: 0;
    }
    .post-nav--both .post-nav__link {
      max-width: 100%;
    }
    .post-nav__link--newer {
      margin-left: 0;
      justify-content: flex-start;
      text-align: left;
    }
  }
</style>
