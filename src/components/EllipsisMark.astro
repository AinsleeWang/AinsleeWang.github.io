---
// EllipsisMark — the brand's "et" ellipsis as three equal nodes (VIS brief
// section 5.3: list endings, card corners). Decorative; colour comes from
// the parent via currentColor.
---

<svg class="ellipsis-mark" width="26" height="6" viewBox="0 0 26 6" aria-hidden="true" focusable="false">
  <circle cx="3" cy="3" r="2.5" fill="currentColor"></circle>
  <circle cx="13" cy="3" r="2.5" fill="currentColor"></circle>
  <circle cx="23" cy="3" r="2.5" fill="currentColor"></circle>
</svg>

<style>
  .ellipsis-mark {
    flex-shrink: 0;
  }
</style>
