---
// FilterBar — plain links to /tags/<tag>/ (no client JS).
import { TAG_LABEL, TAGS } from '../lib/labels';
import type { FilterTag } from '../lib/labels';
import Lat from './Lat.astro';

export interface Props {
  active: FilterTag;
  count: number;
}

const { active, count } = Astro.props;
const items: { key: FilterTag; href: string }[] = [
  { key: 'all', href: '/' },
  ...TAGS.map((t) => ({ key: t, href: `/tags/${t}/` })),
];
---

<nav class="bar" aria-label="依類型篩選">
  {
    items.map((item) => (
      <a href={item.href} aria-current={item.key === active ? 'page' : undefined}>
        {TAG_LABEL[item.key]}
      </a>
    ))
  }
  <span class="count">共 <Lat>{count}</Lat> 篇</span>
</nav>

<style>
  .bar {
    display: flex;
    align-items: baseline;
    gap: 30px;
    padding: 16px 0;
    border-block: 1px solid var(--rule);
  }
  .bar a {
    font-family: var(--zh);
    font-weight: 500;
    font-size: var(--fs-bar);
    letter-spacing: 0.14em;
    color: var(--ink-70);
  }
  .bar a[aria-current] {
    color: var(--ink);
    font-weight: 700;
  }
  .bar a[aria-current]::before {
    content: '● ';
    font-size: var(--fs-bar-dot);
    vertical-align: middle;
    color: var(--moss-600);
  }
  .count {
    margin-left: auto;
    font-family: var(--zh);
    font-size: var(--fs-count);
    letter-spacing: 0.14em;
    color: var(--ink-70);
  }

  @media (max-width: 820px) {
    .bar {
      gap: 18px;
      overflow-x: auto;
      white-space: nowrap;
      padding-block: 0;
    }
    .bar a,
    .count {
      display: flex;
      align-items: center;
      gap: 0.35em;
      min-height: 44px;
    }
  }
</style>
