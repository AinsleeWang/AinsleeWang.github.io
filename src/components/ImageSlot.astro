---
// ImageSlot — a cover image box, per design-ref/wit.et Blog.dc.html (e.g.
// lines 69-71, 186-189, 199-200). With a `cover` it renders the real image
// through astro:assets (AVIF + WebP, responsive widths, cropped to this
// slot's ratio); without one it keeps the placeholder box.
//
// labelPosition exists because the design moves the "IMAGE W:H" label from
// its default bottom-left to top-right whenever the slot carries a text
// overlay (1c line 188, the feature photo card) — otherwise the overlay
// title and the label would collide. The default slot is that overlay; it
// is empty (and unused) for the plain image cases. With a cover the label
// is dropped and a scrim keeps the overlay text legible.
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

export interface Props {
  ratio: string; // CSS aspect-ratio value, e.g. "4/3", "2.4/1", "3/2"
  label?: string;
  labelPosition?: 'bottom-left' | 'top-right';
  cover?: ImageMetadata;
  alt?: string;
  eager?: boolean; // first image on the page loads eagerly, the rest lazy
  widths?: number[];
  sizes?: string;
}

const {
  ratio,
  label,
  labelPosition = 'bottom-left',
  cover,
  alt = '',
  eager = false,
  widths = [640, 960, 1280, 1600],
  sizes = '(max-width: 767px) calc(100vw - 40px), 1136px',
} = Astro.props;
const autoLabel = `IMAGE ${ratio.replace('/', ':')}`;
const hasOverlay = Astro.slots.has('default');

const [rw, rh] = ratio.split('/').map(Number);
const baseWidth = Math.max(...widths);
const baseHeight = Math.round((baseWidth * (rh ?? 1)) / rw);
---

<div
  class={`image-slot image-slot--label-${labelPosition}${cover ? ' image-slot--cover' : ''}`}
  style={`aspect-ratio:${ratio}`}
>
  {
    cover ? (
      <>
        <div class="image-slot__media">
          <Picture
            src={cover}
            alt={alt}
            formats={['avif', 'webp']}
            widths={widths}
            sizes={sizes}
            width={baseWidth}
            height={baseHeight}
            fit="cover"
            fallbackFormat="jpg"
            loading={eager ? 'eager' : 'lazy'}
            decoding={eager ? 'auto' : 'async'}
          />
        </div>
        {hasOverlay && (
          <div class="image-slot__content">
            <slot />
          </div>
        )}
      </>
    ) : (
      <>
        <slot />
        <span class="image-slot__label">{label ?? autoLabel}</span>
      </>
    )
  }
</div>

<style>
  .image-slot {
    position: relative;
    width: 100%;
    background: var(--space-800);
    border: 1px solid var(--line-18);
    border-radius: var(--radius-sm);
  }
  .image-slot:not(.image-slot--cover):has(> :not(.image-slot__label)) {
    display: flex;
    align-items: flex-end;
    padding: 22px;
  }
  .image-slot__label {
    position: absolute;
    font-family: var(--font-mono);
    font-size: var(--fs-meta);
    letter-spacing: 0.06em;
    color: var(--label-70);
  }
  .image-slot--label-bottom-left .image-slot__label {
    left: 12px;
    bottom: 10px;
  }
  .image-slot--label-top-right .image-slot__label {
    right: 12px;
    top: 10px;
  }
  .image-slot--cover {
    overflow: hidden;
  }
  .image-slot__media,
  .image-slot__media :global(picture),
  .image-slot__media :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }
  .image-slot__media :global(img) {
    object-fit: cover;
  }
  .image-slot__content {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: flex-end;
    padding: 22px;
    background: linear-gradient(to top, color-mix(in srgb, var(--space-950) 80%, transparent), transparent 65%);
  }
</style>
