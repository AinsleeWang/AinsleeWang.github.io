---
// ImageSlot — a cover image through astro:assets (AVIF + WebP, responsive
// widths, cropped to the given ratio). No cover, no output: a post without
// an image has no placeholder.
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

export interface Props {
  ratio: string; // CSS aspect-ratio value, e.g. "3/2"
  cover?: ImageMetadata;
  alt?: string;
  eager?: boolean;
  widths?: number[];
  sizes?: string;
}

const {
  ratio,
  cover,
  alt = '',
  eager = false,
  widths = [640, 960, 1280, 1600],
  sizes = '(max-width: 820px) calc(100vw - 44px), 1068px',
} = Astro.props;

const [rw, rh] = ratio.split('/').map(Number);
const baseWidth = Math.max(...widths);
const baseHeight = Math.round((baseWidth * (rh ?? 1)) / rw);
---

{
  cover && (
    <div class="image-slot" style={`aspect-ratio:${ratio}`}>
      <Picture
        src={cover}
        alt={alt}
        formats={['avif', 'webp']}
        widths={widths}
        sizes={sizes}
        width={baseWidth}
        height={baseHeight}
        fit="cover"
        fallbackFormat="jpg"
        loading={eager ? 'eager' : 'lazy'}
        decoding={eager ? 'auto' : 'async'}
      />
    </div>
  )
}

<style>
  .image-slot {
    width: 100%;
    overflow: hidden;
    background: var(--band);
  }
  .image-slot :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
