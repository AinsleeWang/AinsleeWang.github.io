---
// MonoTag — the "essay  2026.08.21" mono-uppercase tag+date row used on
// every PostCard variant and the filter bar's active item in 1c.
// Shared by E-1.2; E-1.3 reuses it on article pages.
export interface Props {
  tag: string;
  date?: string;
}

const { tag, date } = Astro.props;
---

<div class="mono-tag">
  <span class="mono-tag__label">{tag}</span>
  {date && <span class="mono-tag__date">{date}</span>}
</div>

<style>
  .mono-tag {
    font-family: var(--font-mono);
    font-size: var(--fs-meta);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-variant-numeric: tabular-nums;
    color: var(--moss-300);
  }
  .mono-tag__date {
    margin-left: 14px;
    color: var(--muted-62);
  }
</style>
