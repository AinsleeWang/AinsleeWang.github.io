---
// ReadingHead — kicker, h1 and meta line (date, place, reading time) used by ArticleLayout
// (design-ref/editorial/essay.html .head).
import type { Post } from '../lib/posts';
import { formatDate, readingMinutes } from '../lib/posts';
import { TAG_LABEL } from '../lib/labels';
import Lat from './Lat.astro';
import Mixed from './Mixed.astro';

// Without `post` the head is a plain page head (kicker + h1 only, used by
// 關於); `latin` sets a Latin-only h1 in Garamond italic.
export interface Props {
  post?: Post;
  kicker?: string;
  title?: string;
  latin?: boolean;
}

const { post, latin = false } = Astro.props;
const kicker = post ? TAG_LABEL[post.data.tag] : Astro.props.kicker;
const title = post ? post.data.title : Astro.props.title;
---

<div class="head">
  <div class="kick">{kicker}</div>
  <h1 class={latin ? 'latin' : undefined}>{title}</h1>
  {post && (
    <p class="meta">
      <span>
        <Lat>{formatDate(post.data.date)}</Lat>
        {post.data.location && (
          <>
            {'　'}
            <Mixed text={post.data.location} />
          </>
      )}
    </span>
    <span>約 <Lat>{readingMinutes(post)}</Lat> 分鐘</span>
  </p>
  )}
</div>

<style>
  .head {
    padding: 76px 0 44px;
  }
  h1 {
    margin-top: 26px;
    max-width: 16em;
    font-family: var(--zh);
    font-weight: 700;
    font-size: var(--fs-h1);
    line-height: 1.36;
    letter-spacing: 0.02em;
    text-wrap: balance;
  }
  h1.latin {
    font-family: var(--en);
    font-style: italic;
    font-weight: 500;
    letter-spacing: 0;
  }
  .meta {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    flex-wrap: wrap;
    margin-top: 28px;
  }

  @media (max-width: 820px) {
    .head {
      padding: 40px 0 30px;
    }
  }
</style>
