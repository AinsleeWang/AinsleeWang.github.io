---
// EmptyState — shown when there are zero published posts overall or for a
// tag (POLISH-SPEC section 1). The ellipsis is three --moss-300 nodes drawn
// in SVG (decorative), then the line and a mono caption. Deep-space only.
---

<div class="empty-state">
  <svg class="empty-state__dots" width="44" height="12" viewBox="0 0 44 12" aria-hidden="true" focusable="false">
    <circle cx="6" cy="6" r="3" fill="var(--moss-300)"></circle>
    <circle cx="22" cy="6" r="3" fill="var(--moss-300)"></circle>
    <circle cx="38" cy="6" r="3" fill="var(--moss-300)"></circle>
  </svg>
  <p class="empty-state__title">清單還在寫。</p>
  <p class="empty-state__caption">NOTHING HERE YET …</p>
</div>

<style>
  .empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 96px 0 88px;
    min-width: 0;
  }
  .empty-state__dots {
    margin: 0 auto;
  }
  .empty-state__title {
    margin: 28px 0 0;
    font-family: var(--font-stack);
    font-size: var(--fs-empty-title);
    line-height: 1.5;
    color: var(--fg);
  }
  .empty-state__caption {
    margin: 12px 0 0;
    font-family: var(--font-mono);
    font-size: var(--fs-meta);
    letter-spacing: 0.06em;
    color: var(--muted-62);
  }

  @media (max-width: 767px) {
    .empty-state {
      padding: 64px 0 56px;
    }
  }
</style>
