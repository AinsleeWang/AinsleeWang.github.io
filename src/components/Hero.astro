---
// Hero — "wit, et cetera." title + zh subtitle + star-chart SVG, per
// design-ref/wit.et Blog.dc.html 1a lines 55-59. Deep-space only; appears
// once, on the homepage.
---

<div class="hero">
  <svg
    class="hero__chart"
    width="520"
    height="200"
    viewBox="0 0 520 200"
    fill="none"
    aria-hidden="true"
  >
    <path d="M20 190 C 160 40, 380 20, 520 60" stroke="var(--moss-300)" stroke-width="1" fill="none" opacity=".45"></path>
    <circle cx="150" cy="70" r="2" fill="var(--moss-300)"></circle>
    <circle cx="242" cy="38" r="1.5" fill="var(--moss-300)"></circle>
    <circle cx="330" cy="96" r="2.5" fill="var(--moss-300)"></circle>
    <circle cx="418" cy="52" r="1.5" fill="var(--moss-300)"></circle>
    <circle cx="470" cy="122" r="2" fill="var(--starglow)"></circle>
    <path d="M150 70 L242 38 L330 96 L418 52 L470 122" stroke="var(--moss-300)" stroke-width="1" opacity=".35" fill="none"></path>
  </svg>
  <h1 class="hero__title">wit, et cetera.</h1>
  <p class="hero__subtitle">才智，以及其他。一份永遠沒寫完的清單——程式、文字、照片、路上。</p>
</div>

<style>
  .hero {
    position: relative;
    padding: 20px 0 40px;
    border-top: 1px solid var(--line-22);
    overflow: hidden;
  }
  .hero__chart {
    position: absolute;
    right: -40px;
    top: 0;
    opacity: 0.5;
  }
  .hero__title {
    margin: 0;
    font-family: var(--font-en);
    font-size: var(--fs-hero);
    line-height: 1.1;
    font-weight: 500;
    letter-spacing: -0.02em;
  }
  .hero__subtitle {
    margin: 14px 0 0;
    font-family: var(--font-zh);
    font-size: var(--fs-hero-sub);
    line-height: 1.9;
    color: var(--muted-62);
    max-width: 520px;
  }

  @media (max-width: 767px) {
    .hero__chart {
      display: none;
    }
    .hero__title {
      font-size: var(--fs-hero-mobile);
    }
  }
</style>
